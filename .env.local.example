# Supabase — Project Settings → API
# Same Supabase project as the admin (dropscale-da); the portal uses its own
# tables (clients, ad_accounts, …) behind their own RLS.
# Copy this file to .env.local and fill in your project's keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public base URL of THIS portal deployment. Used to build the links embedded
# in Supabase password-reset emails.
#
# Set it explicitly. Without it the app falls back to the request origin, and
# if that URL is not in Supabase → Authentication → URL Configuration →
# Redirect URLs, Supabase silently ignores it and uses the project's Site URL
# instead — which is how reset emails end up pointing at another domain.
# Port 3001 so it can run alongside the admin (3000) in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Google Ads API (server-only — NOT NEXT_PUBLIC; set as Worker secrets in prod)
#
# Connection model: per-client OAuth. Each client clicks "Connect Google Ads"
# in the portal and authorises their own account; the portal stores their
# refresh token per ad_account, encrypted. So these are only the agency's
# shared OAuth *app* credentials + the developer token + the encryption key —
# there is NO agency refresh token here.
#
# When these are unset, the portal shows seeded demo data. Once they are set
# and a client has connected an account (with a Customer ID), that account
# shows live data.
#
# How to obtain each — walkthrough in scripts/google-ads-setup.md:
#   DEVELOPER_TOKEN   Google Ads → Tools → API Center.
#   CLIENT_ID/SECRET  Google Cloud Console → Credentials → OAuth 2.0 client
#                     (Web application). Add BOTH redirect URIs:
#                       https://dropscale.app/api/google-ads/callback
#                       http://localhost:3001/api/google-ads/callback
#   TOKEN_ENC_KEY     32 random bytes, base64. Generate with:
#                       node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_TOKEN_ENC_KEY=
# Optional — the AGENCY's manager account (digits; dashes stripped). Used only
# by the service-account path below; per-client OAuth queries never send it.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional — defaults to the current API version in code. Bump when one sunsets.
# GOOGLE_ADS_API_VERSION=v25
# Optional — the AGENCY's own connection: a service-account JSON key
# (single-line JSON, or base64 of it). With it set, admin features read the
# ad accounts granted to that account in Google Ads → Admin → Access and
# security — no OAuth, no consent screens. Status card in /admin/settings.
# GOOGLE_ADS_SA_KEY_JSON=

# Windsor — Google Ads authorization for Client Onboarding V2 (server-only).
# Shopify is connected directly by Dropscale and never uses Windsor. The key
# must be stored as a Worker secret; it is never sent to the browser. The
# client receives only Windsor's short-lived, Google-only co-user URL.
WINDSOR_API_KEY=

# -----------------------------------------------------------------------------
# Billing — manual Stripe invoices (server-only; Worker secrets in prod)
#
# Clients pay Google directly. The Billing admin reviews a closed
# Monday→Sunday week and explicitly issues ONLY the Dropscale agency fee:
# 10% of that client's Google Ads spend, always in EUR. Every invoice uses
# `send_invoice`; the client opens Stripe's hosted link and chooses when to pay.
# No page load creates an invoice and no saved card is auto-charged. Scheduled
# issue remains off unless every fail-closed automation gate below is armed.
#
# Stripe + webhook + service role are required for live payment state. The cron
# secret protects scheduled Google/ledger refreshes and billing work.
#
# Set them for production with:
#   npx wrangler secret put BILLING_ISSUANCE_ENABLED
#   npx wrangler secret put BILLING_AUTOMATION_ENABLED
#   npx wrangler secret put BILLING_AUTOMATION_ISSUANCE_ARMED
#   npx wrangler secret put BILLING_AUTOMATION_RECOVERY_ARMED
#   npx wrangler secret put STRIPE_SECRET_KEY
#   npx wrangler secret put STRIPE_WEBHOOK_SECRET
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put CRON_SECRET
# (`wrangler secret put`, NOT a [vars] block — these must never be in git. They
# are readable via process.env at runtime thanks to the
# nodejs_compat_populate_process_env flag in wrangler.jsonc.)

# Master fail-closed gate for POST /api/billing/generate. Only the exact
# lowercase value `true` permits an authenticated admin to reach service-role
# or Stripe-backed issue code. Unset, blank, `false`, `TRUE`, and padded values
# all return 503 without creating or sending an invoice.
BILLING_ISSUANCE_ENABLED=

# Shared automation subsystem gate. Scheduled invoice issue additionally needs
# BILLING_ISSUANCE_ENABLED and BILLING_AUTOMATION_ISSUANCE_ARMED to be exact
# lowercase `true`; while either is off, its cron path remains reconcile-only.
BILLING_AUTOMATION_ENABLED=
BILLING_AUTOMATION_ISSUANCE_ARMED=

# Recovery-only lock for the purpose-bound skipped-cycle repair route. The two
# recovery flags must be exact lowercase `true` while
# BILLING_ISSUANCE_ENABLED remains unset/false, and the caller must explicitly
# POST `/api/billing/cron?mode=recovery` with CRON_SECRET. Ordinary cron calls
# keep reconciling Stripe only. Remove/disable the recovery arm after the repair.
BILLING_AUTOMATION_RECOVERY_ARMED=

# Stripe → Developers → API keys. Prefer a restricted live key (`rk_live_…`)
# limited to Customers, Invoices and Invoice Items; an unrestricted
# `sk_live_…` must remain server-only. API requests are pinned in code to
# 2026-02-25.clover.
STRIPE_SECRET_KEY=

# Stripe → Developers → Webhooks → "Add endpoint":
#   URL     https://dropscale.app/api/stripe/webhook
#   Version 2026-02-25.clover
#   Events  invoice.paid, invoice.payment_succeeded, invoice.payment_failed,
#           invoice.sent, invoice.updated, invoice.finalized, invoice.voided,
#           invoice.marked_uncollectible
# Then copy the endpoint's signing secret (`whsec_…`) here. This is what marks
# an invoice paid; a daily reconciliation is only the missed-delivery safety
# net. For local dev: `stripe listen --forward-to
# localhost:3001/api/stripe/webhook` prints a whsec_ to use instead.
STRIPE_WEBHOOK_SECRET=

# Supabase → Project Settings → API → server secret. Use a current `sb_secret_…`
# key (preferred) or the legacy JWT whose payload role is actually
# `service_role`. BYPASSES RLS — callers without a browser session need it for
# signed Stripe webhooks, scheduled ledger refreshes and the read-only daily
# report below. It never issues an invoice on its own. Never expose it to a
# browser; it must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret scheduled refresh routes authenticate with. Treat it like a
# password and generate it, don't invent it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When it is unset the route refuses to run rather than falling open.
CRON_SECRET=

# Read-only key for GET /api/reports/daily — the Discord report bot's, and only
# its. Deliberately NOT CRON_SECRET: this one lives on somebody else's server,
# so it has to be rotatable on its own, and leaking it exposes yesterday's
# figures rather than the ability to trigger a billing run. Generate it, never
# invent it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset → the route answers 503 and reads nothing.
REPORT_API_KEY=

# -----------------------------------------------------------------------------
# Telegram alerts — the admin approval inbox, pushed to the team's phones
#
# Same four events as the bell in the admin chrome (new client, ad account to
# activate, account request, creatives submitted). Telegram rather than web
# push because web push on iOS only reaches a site installed to the Home
# Screen, and these are internal team alerts a client never sees.
#
# Wiring, once the secrets below are set:
#   Supabase → Database → Webhooks → "Create a new hook", one per table
#     (portal_clients, ad_accounts, account_requests, creative_submissions)
#     Events  Insert
#     Type    HTTP Request → POST https://dropscale.app/api/notify/telegram
#     Header  Authorization: Bearer <NOTIFY_SECRET>
#
# Verify without waiting for a real client: signed in as an admin, POST
# {"test":true} to that route from the browser console.
#
# From @BotFather, after /newbot. Treat it like a password — anyone holding it
# can post as the bot. Worker secret in prod: npx wrangler secret put TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=
# The destination chat. For a group, add the bot to it and read the negative id
# (e.g. -1001234567890) from https://api.telegram.org/bot<TOKEN>/getUpdates
# after posting a message there. Unset → nothing is sent and nothing breaks.
TELEGRAM_CHAT_ID=
# Shared secret the Supabase webhook presents. Deliberately NOT CRON_SECRET:
# this one is configured in the Supabase dashboard rather than on the Worker,
# so it has its own blast radius and rotates on its own. Generate it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset → the route refuses every webhook rather than falling open.
NOTIFY_SECRET=

# Only set while rotating GOOGLE_ADS_TOKEN_ENC_KEY: the OLD key. Decryption
# tries the current key and falls back to this one, so the app keeps working
# between re-encrypting the database and updating the deployed secret. Encryption
# never uses it. Delete it once scripts/rotate-enc-key.mjs reports nothing left
# to migrate — leaving it set keeps a retired key able to read live data.
GOOGLE_ADS_TOKEN_ENC_KEY_PREVIOUS=
