# Supabase — Project Settings → API
# Same Supabase project as the admin (dropscale-da); the portal uses its own
# tables (clients, ad_accounts, …) behind their own RLS.
# Copy this file to .env.local and fill in your project's keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Public base URL of THIS portal deployment. Used to build the links embedded
# in Supabase password-reset emails.
#
# Set it explicitly. Without it the app falls back to the request origin, and
# if that URL is not in Supabase → Authentication → URL Configuration →
# Redirect URLs, Supabase silently ignores it and uses the project's Site URL
# instead — which is how reset emails end up pointing at another domain.
# Port 3001 so it can run alongside the admin (3000) in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Google Ads API (server-only — NOT NEXT_PUBLIC; set as Worker secrets in prod)
#
# Connection model: per-client OAuth. Each client clicks "Connect Google Ads"
# in the portal and authorises their own account; the portal stores their
# refresh token per ad_account, encrypted. So these are only the agency's
# shared OAuth *app* credentials + the developer token + the encryption key —
# there is NO agency refresh token here.
#
# When these are unset, the portal shows seeded demo data. Once they are set
# and a client has connected an account (with a Customer ID), that account
# shows live data.
#
# How to obtain each — walkthrough in scripts/google-ads-setup.md:
#   DEVELOPER_TOKEN   Google Ads → Tools → API Center.
#   CLIENT_ID/SECRET  Google Cloud Console → Credentials → OAuth 2.0 client
#                     (Web application). Add BOTH redirect URIs:
#                       https://dropscale.app/api/google-ads/callback
#                       http://localhost:3001/api/google-ads/callback
#   TOKEN_ENC_KEY     32 random bytes, base64. Generate with:
#                       node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_TOKEN_ENC_KEY=
# Optional — the AGENCY's manager account (digits; dashes stripped). Used only
# by the service-account path below; per-client OAuth queries never send it.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional — defaults to the current API version in code. Bump when one sunsets.
# GOOGLE_ADS_API_VERSION=v21
# Optional — the AGENCY's own connection: a service-account JSON key
# (single-line JSON, or base64 of it). With it set, admin features read the
# ad accounts granted to that account in Google Ads → Admin → Access and
# security — no OAuth, no consent screens. Status card in /admin/settings.
# GOOGLE_ADS_SA_KEY_JSON=

# -----------------------------------------------------------------------------
# Billing — Stripe + the Monday cron (server-only; Worker secrets in prod)
#
# What the weekly run bills: every Monday 06:00 UTC the cron closes the
# Monday→Sunday week just ended and invoices each client for
#   (a) the Google Ads spend the agency fronted, at cost,
#   (b) the management fee on that spend (each account's commission_rate, 10%
#       by default), and
#   (c) the revenue share, for accounts that have it switched on.
# A client who has saved a card is charged automatically; everyone else gets a
# payable Stripe link with 7 days to pay.
#
# ALL FOUR are required for automatic weekly billing. With none of them set the
# Payments tab still renders — it just shows no invoices.
#
# Set them for production with:
#   npx wrangler secret put STRIPE_SECRET_KEY
#   npx wrangler secret put STRIPE_WEBHOOK_SECRET
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put CRON_SECRET
# (`wrangler secret put`, NOT a [vars] block — these must never be in git. They
# are readable via process.env at runtime thanks to the
# nodejs_compat_populate_process_env flag in wrangler.jsonc.)

# Stripe → Developers → API keys → Secret key. `sk_test_…` while you are
# validating, `sk_live_…` when you go live. This one key is enough for the
# feature to work end to end.
STRIPE_SECRET_KEY=

# Stripe → Developers → Webhooks → "Add endpoint":
#   URL     https://dropscale.app/api/stripe/webhook
#   Events  invoice.paid, invoice.payment_succeeded, invoice.payment_failed,
#           invoice.finalized, invoice.voided, invoice.marked_uncollectible,
#           checkout.session.completed
# Then copy the endpoint's signing secret (`whsec_…`) here. This is what marks
# an invoice paid; without it payment state only updates when an admin opens a
# billing page. For local dev: `stripe listen --forward-to
# localhost:3001/api/stripe/webhook` prints a whsec_ to use instead.
STRIPE_WEBHOOK_SECRET=

# Supabase → Project Settings → API → service_role key. BYPASSES RLS — three
# callers are entitled to it and none has a user session: the Stripe webhook
# (writes payment state), the Monday cron (reads the admin-only commission
# ledger, writes invoices) and the read-only daily report below. Never expose it
# to a browser; it must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the cron authenticates with. /api/billing/cron is a public URL,
# so this is the only thing stopping anyone from triggering a billing run —
# treat it like a password and generate it, don't invent it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When it is unset the route refuses to run rather than falling open.
CRON_SECRET=

# Read-only key for GET /api/reports/daily — the Discord report bot's, and only
# its. Deliberately NOT CRON_SECRET: this one lives on somebody else's server,
# so it has to be rotatable on its own, and leaking it exposes yesterday's
# figures rather than the ability to trigger a billing run. Generate it, never
# invent it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset → the route answers 503 and reads nothing.
REPORT_API_KEY=

# Only set while rotating GOOGLE_ADS_TOKEN_ENC_KEY: the OLD key. Decryption
# tries the current key and falls back to this one, so the app keeps working
# between re-encrypting the database and updating the deployed secret. Encryption
# never uses it. Delete it once scripts/rotate-enc-key.mjs reports nothing left
# to migrate — leaving it set keeps a retired key able to read live data.
GOOGLE_ADS_TOKEN_ENC_KEY_PREVIOUS=
