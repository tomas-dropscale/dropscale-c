{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dropscale-da",
  // Not .open-next/worker.js directly: custom-worker.ts wraps the generated
  // fetch handler and adds the weekly billing cron below. OpenNext's worker
  // exports fetch only, so a scheduled handler has to live in a wrapper.
  "main": "custom-worker.ts",
  "compatibility_date": "2025-03-25",
  "triggers": {
    "crons": [
      // Mondays 06:00 UTC — bill the Monday→Sunday week that just closed. Late
      // enough that Google Ads has settled Sunday's spend, early enough that the
      // invoice is waiting when the client starts their week.
      "0 6 * * 1",
      // Hourly on the hour, from midnight UTC — rebuild the metrics rollup the
      // client reports read, then the commission ledger the finance pages read.
      // The countdown in the report is derived from this same schedule, so if
      // this expression changes, change PERIOD_MINUTES in next-refresh.tsx too.
      "0 * * * *",
      // 23:55 — close the day. Pulls every account's Google spend and Shopify
      // revenue into daily_metrics before the date rolls over, so the client
      // reports show a complete day rather than whatever the last page view
      // happened to capture.
      "55 23 * * *"
    ]
  },
  // populate_process_env: with a compatibility_date before 2025-04-01, Workers
  // do NOT copy bindings into process.env — so every runtime secret (the
  // GOOGLE_ADS_* set) read via process.env comes back undefined even though
  // `wrangler secret list` shows it. This flag turns the copying on without
  // moving the compat date and risking other runtime behaviour changes.
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
