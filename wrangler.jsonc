{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dropscale-da",
  // Not .open-next/worker.js directly: custom-worker.ts wraps the generated
  // fetch handler and adds operational cron handlers below. OpenNext's worker
  // exports fetch only, so a scheduled handler has to live in a wrapper.
  "main": "custom-worker.ts",
  "compatibility_date": "2025-03-25",
  "triggers": {
    "crons": [
      // TEMPORARY: resume one fixed, fenced Lara product-quarantine run.
      // Remove immediately after the ten Admin/public states are verified.
      "*/2 * * * *",
      // Mondays 14:05 UTC - every Google account timezone has crossed into
      // Monday, with extra time for Sunday's delayed Google reporting. Capture
      // the exact closed-week evidence and reconcile Stripe payment state;
      // invoice issue remains manual in /admin/billing.
      "5 14 * * 1",
      // Hourly on the hour, from midnight UTC — rebuild the metrics rollup the
      // client reports read, then the commission ledger the finance pages read.
      // The countdown in the report is derived from this same schedule, so if
      // this expression changes, change PERIOD_MINUTES in next-refresh.tsx too.
      "0 * * * *",
      // 23:55 — close the day and reconcile all open Stripe invoices. This
      // bounds stale payment state to one day even if a webhook delivery is
      // missed, while still keeping the webhook as the primary live path.
      "55 23 * * *"
    ]
  },
  // populate_process_env: with a compatibility_date before 2025-04-01, Workers
  // do NOT copy bindings into process.env — so every runtime secret (the
  // GOOGLE_ADS_* set) read via process.env comes back undefined even though
  // `wrangler secret list` shows it. This flag turns the copying on without
  // moving the compat date and risking other runtime behaviour changes.
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
